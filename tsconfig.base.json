{
  "compilerOptions": {
    "outDir": "out",
    "target": "ES2021",
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "__mocks__": ["__mocks__"],
      "__mocks__/*": ["__mocks__/*"],
      "apiCalls": ["apiCalls"],
      "apiCalls/*": ["apiCalls/*"],
      "assets/*": ["assets/*"],
      "constants": ["constants"],
      "constants/*": ["constants/*"],
      "containers": ["containers"],
      "containers/*": ["containers/*"],
      "contexts": ["contexts"],
      "contexts/*": ["contexts/*"],
      "helpers": ["helpers"],
      "helpers/*": ["helpers/*"],
      "hooks": ["hooks"],
      "hooks/*": ["hooks/*"],
      "lib": ["lib"],
      "lib/*": ["lib/*"],
      "operations": ["operations"],
      "operations/*": ["operations/*"],
      "tests": ["tests"],
      "tests/*": ["tests/*"],
      "types": ["types"],
      "types/*": ["types/*"],
      "UI": ["UI"],
      "UI/*": ["UI/*"],
      "utilities": ["utilities"],
      "utilities/*": ["utilities/*"],
      "validateSignTransactions": ["validateSignTransactions"],
      "validateSignTransactions/*": ["validateSignTransactions/*"],
      "validation": ["validation"],
      "validation/*": ["validation/*"],
      "validationSchema": ["validationSchema"],
      "validationSchema/*": ["validationSchema/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}
